{
  "version": "1.0.0",
  "status_enum": [
    "pass",
    "fail",
    "unknown",
    "not_run",
    "not_applicable"
  ],
  "detector_implementation": "specification_only",
  "rules": [
    {
      "id": "R01",
      "node": "intent",
      "title": "业务前提可确定",
      "checker_kind": "product_decision",
      "severity": "blocking",
      "applies_when": "需求驱动选型",
      "required_inputs": "brief",
      "assertion": "核心目标、业务分支及授权范围明确",
      "pass_condition": "无关键歧义或用户已提供分支",
      "on_unknown": "decision_required",
      "repair_target": "brief",
      "exceptions": []
    },
    {
      "id": "R02",
      "node": "context",
      "title": "目标覆盖",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "本次目标已定义",
      "required_inputs": "targets,knowledge_bindings",
      "assertion": "每个必需目标有实现要求及来源状态",
      "pass_condition": "必需目标齐全；缺证据单列",
      "on_unknown": "block_required_target",
      "repair_target": "context",
      "exceptions": []
    },
    {
      "id": "R03",
      "node": "retrieval",
      "title": "Query用途与来源适配",
      "checker_kind": "mixed",
      "severity": "major",
      "applies_when": "存在检索计划",
      "required_inputs": "query_bundle,targets,budget",
      "assertion": "签名、目标、来源能力与预算完整",
      "pass_condition": "无未解释重复和漂移",
      "on_unknown": "retain_gap",
      "repair_target": "query_bundle",
      "exceptions": []
    },
    {
      "id": "R04",
      "node": "evidence",
      "title": "Claim支持",
      "checker_kind": "evidence_review",
      "severity": "blocking",
      "applies_when": "知识用于选型",
      "required_inputs": "claims,captures",
      "assertion": "每条结论有对应证据且不越界",
      "pass_condition": "具体支持成立，推断另标",
      "on_unknown": "downgrade_claim",
      "repair_target": "claims",
      "exceptions": []
    },
    {
      "id": "R05",
      "node": "evidence",
      "title": "引用与状态语义",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "结构化知识",
      "required_inputs": "objects,relations",
      "assertion": "唯一ID、精确端点、三类状态分离",
      "pass_condition": "无悬空/错位/通配外键",
      "on_unknown": "block",
      "repair_target": "knowledge",
      "exceptions": []
    },
    {
      "id": "R06",
      "node": "explore",
      "title": "业务与兼容门禁",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "候选选择",
      "required_inputs": "brief,candidate,mappings",
      "assertion": "已登记并明确兼容，条件依赖闭合",
      "pass_condition": "业务匹配、必需模块与owner存在",
      "on_unknown": "block",
      "repair_target": "candidate",
      "exceptions": []
    },
    {
      "id": "R07",
      "node": "explore",
      "title": "变体分类与身份",
      "checker_kind": "mixed",
      "severity": "blocking",
      "applies_when": "相对基准变体",
      "required_inputs": "base,candidate,diff",
      "assertion": "纯视觉保留结构/接口/事件；新增能力显式",
      "pass_condition": "分类与实际diff一致",
      "on_unknown": "block_claim",
      "repair_target": "candidate_class",
      "exceptions": []
    },
    {
      "id": "R08",
      "node": "explore",
      "title": "配置多样性",
      "checker_kind": "mixed",
      "severity": "major",
      "applies_when": "多候选批次",
      "required_inputs": "batch_plan,dna,policy",
      "assertion": "同分支比较实际值并报告最近对与已知率",
      "pass_condition": "满足本次事前策略且非只换名",
      "on_unknown": "report_shortfall",
      "repair_target": "batch_plan",
      "exceptions": []
    },
    {
      "id": "R09",
      "node": "assets",
      "title": "实际素材满足",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "完整视觉就绪声明",
      "required_inputs": "asset_files,requirements,licenses",
      "assertion": "实际合格数量、尺寸、裁切、授权齐全",
      "pass_condition": "逐文件检查通过并去重",
      "on_unknown": "unmet",
      "repair_target": "asset_bindings",
      "exceptions": []
    },
    {
      "id": "R10",
      "node": "assets",
      "title": "素材协调与真实性",
      "checker_kind": "visual_review",
      "severity": "major",
      "applies_when": "使用图像叙述",
      "required_inputs": "images,claims,quality_reviews",
      "assertion": "配套摄影协调且不伪造场景身份",
      "pass_condition": "具体图片评审通过或明确演示边界",
      "on_unknown": "conditional",
      "repair_target": "assets",
      "exceptions": []
    },
    {
      "id": "R11",
      "node": "compile",
      "title": "布局与Foundation一致",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "存在布局契约",
      "required_inputs": "layout,tokens,breakpoints",
      "assertion": "加总、容纳、断点和遮罩文字保护成立",
      "pass_condition": "所有适用边界均通过",
      "on_unknown": "block",
      "repair_target": "source_config",
      "exceptions": []
    },
    {
      "id": "R12",
      "node": "compile",
      "title": "Query自足与一致",
      "checker_kind": "mixed",
      "severity": "blocking",
      "applies_when": "生成handoff",
      "required_inputs": "resolved,query,prompt,manifest",
      "assertion": "必需规格内联、资产路径可用、三者一致",
      "pass_condition": "无必要跨GQ依赖与未解析值",
      "on_unknown": "block",
      "repair_target": "compiler",
      "exceptions": []
    },
    {
      "id": "R13",
      "node": "compile",
      "title": "原子发布与失效",
      "checker_kind": "execution",
      "severity": "blocking",
      "applies_when": "输出run",
      "required_inputs": "valid_outputs,managed_files",
      "assertion": "失败未选和待决三状态不留下有效旧产物",
      "pass_condition": "清单与实际文件/状态一致",
      "on_unknown": "block_publish",
      "repair_target": "publisher",
      "exceptions": []
    },
    {
      "id": "R14",
      "node": "build",
      "title": "核心行为与状态",
      "checker_kind": "execution",
      "severity": "blocking",
      "applies_when": "声明实现完成",
      "required_inputs": "build,state_matrix,event_contract",
      "assertion": "核心链、错误恢复、焦点与payload实测",
      "pass_condition": "所有必需行为通过",
      "on_unknown": "not_run",
      "repair_target": "implementation",
      "exceptions": []
    },
    {
      "id": "R15",
      "node": "build",
      "title": "视觉及Motion质量",
      "checker_kind": "mixed",
      "severity": "major",
      "applies_when": "页面验收",
      "required_inputs": "screenshots,motion_spec,quality_rules",
      "assertion": "层级、素材、响应式及减少动效符合契约",
      "pass_condition": "有环境证据，无关键遮挡和品类错配",
      "on_unknown": "partial",
      "repair_target": "implementation_or_assets",
      "exceptions": []
    },
    {
      "id": "R16",
      "node": "refine",
      "title": "受限补丁无回归",
      "checker_kind": "mixed",
      "severity": "blocking",
      "applies_when": "局部修复",
      "required_inputs": "base_hash,patch,issues,locks",
      "assertion": "基线新鲜、锁未破坏、原问题解决",
      "pass_condition": "diff与实际截图/行为均通过",
      "on_unknown": "requires_replan",
      "repair_target": "patch",
      "exceptions": []
    },
    {
      "id": "R17",
      "node": "final",
      "title": "批次感知差异",
      "checker_kind": "visual_review",
      "severity": "major",
      "applies_when": "声明N页多样性完成",
      "required_inputs": "comparison_sheets,batch_policy,results",
      "assertion": "统一视口比较界面与图片、最近候选对",
      "pass_condition": "N页质量通过且人眼差异有具体证据",
      "on_unknown": "report_shortfall",
      "repair_target": "weaker_candidate",
      "exceptions": []
    },
    {
      "id": "R18",
      "node": "final",
      "title": "验证范围与反馈",
      "checker_kind": "deterministic",
      "severity": "blocking",
      "applies_when": "最终交付",
      "required_inputs": "results,claims,implementation_mappings",
      "assertion": "只升级实际通过的对象和环境范围",
      "pass_condition": "完成计数和未决项与证据一致",
      "on_unknown": "retain_unknown",
      "repair_target": "report",
      "exceptions": []
    }
  ]
}
